{
    "_runner": {
        "max_iterations": 400
    },
    "_defaults": {
        "model": "gpt-5.6-luna",
        "reasoning": {
            "effort": "high",
            "summary": "auto"
        },
        "parallel_tool_calls": false,
        "max_iterations": 10
    },
    "_swarm": {
        "model": "gpt-5.6-luna",
        "max_iterations": 250,
        "max_depth": 4,
        "max_concurrent": 6,
        "max_budget": 50,
        "report_max_chars": 40000,
        "parallel_tool_calls": true,
        "reasoning": {"effort": "xhigh", "summary": "auto"},
        "tools": ["edit_file", "web_fetch", "interpret_image", "memory_query", "spawn_agent"],
        "shell_tools": ["run_command"]
    },
    "ExecutorAgent": {
        "tools": ["WebSearchAgent", "DeviceManagerAgent", "PlaywrightSessionAgent", "save_preference", "run_command", "edit_file", "memory_query", "interpret_image", "deploy_swarm"],
        "main": true,
        "json_response": false
    },
    "WebSearchAgent": {
        "tools": [{"type": "web_search"}],
        "json_response": false,
        "parallel_tool_calls": true,
        "model": "gpt-5.6-luna"
    },
    "DeviceManagerAgent": {
        "tools": ["run_command", "edit_file", "WebSearchAgent", "PlaywrightSessionAgent", "memory_query", "playwright_navigate", "web_fetch", "interpret_image"],
        "json_response": true,
        "parallel_tool_calls": true
    },
    "PlaywrightSessionAgent": {
        "tools": ["playwright_session", "web_fetch", "run_command", "edit_file", "interpret_image", "memory_query"],
        "json_response": true,
        "parallel_tool_calls": true
    }
}
